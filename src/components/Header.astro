---
import { Image } from 'astro:assets';
import Logo from "../assets/NBCL_Logo.svg";

const navItems = [
  { name: 'Features', href: '#features' },
  { name: 'Documentation', href: '/docs' },
  { name: "Playground", href: "/playground" },
];
---

<header class="sticky top-0 z-50 w-full border-b border-app-text/10 bg-app-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    
    <!-- Logo -->
    <div class="flex items-center gap-2">
      <Image src={Logo} alt="Nbcl Logo" width="40" height="40" class="header-logo"/>
      <span class="text-xl font-bold tracking-tight text-app-text">NBCL</span>
    </div>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex md:gap-x-8">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="text-sm font-medium text-app-text/70 transition-colors hover:text-accent"
        >
          {item.name}
        </a>
      ))}
    </nav>

    <!-- Right Side Actions -->
    <div class="flex items-center gap-4">
        <a 
            href="https://github.com/NBCL-Lang/nbcl"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md p-2 text-app-text/70 hover:bg-app-text/5 hover:text-app-text transition-colors"
            aria-label="GitHub Repository"
        >
            <svg class="size-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
        </a>

        <button 
            id="theme-toggle" 
            class="rounded-md p-2 hover:bg-app-text/5 text-app-text/70 transition-colors"
            aria-label="Toggle dark mode"
        >
            <!-- Simple Sun/Moon Icon (SVG) -->
            <svg id="sun" class="hidden size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
            </svg>
            <svg id="moon" class="hidden size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 1111.003 3.004a11.311 11.311 0 0010.749 11.998z" />
            </svg>
        </button>
      
      <a href="/docs" class="hidden sm:block rounded-full bg-accent px-4 py-2 text-sm font-semibold text-white shadow-sm hover:opacity-90 transition-opacity">
        Get Started
      </a>

      <!-- Mobile Menu Button -->
      <button class="md:hidden p-2 text-app-text" aria-label="Open menu">
        <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  const sun = document.getElementById('sun');
  const moon = document.getElementById('moon');

  function updateIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    sun?.classList.toggle('hidden', !isDark);
    moon?.classList.toggle('hidden', isDark);
  }

  btn?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    const isDark = document.documentElement.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateIcons();
  });

  if (localStorage.getItem('theme') === 'dark' || 
     (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.classList.add('dark');
  }
  updateIcons();
</script>